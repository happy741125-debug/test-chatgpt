APP_ENV=development
LOG_LEVEL=INFO
OPS_API_TOKEN=replace-with-a-long-random-admin-token
DATABASE_URL=postgresql+psycopg://workhub:workhub@localhost:5432/workhub
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=workhub:jobs
REDIS_RETRY_KEY=workhub:jobs:retry
REDIS_DLQ_KEY=workhub:jobs:dlq
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=
LINE_SILENT_MODE=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/callback
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-long-random-secret
DASHBOARD_URL=http://localhost:3000
GMAIL_INITIAL_SYNC_DAYS=7
GMAIL_INITIAL_SYNC_LIMIT=50
GMAIL_SYNC_TOKEN=replace-with-a-long-random-scheduler-token
CONTEXT_BUFFER_SECONDS=180
CONTEXT_WINDOW_MINUTES=15
CONTEXT_MAX_MESSAGES=30
AI_PROVIDER=disabled
# 影子模式：規則版照常產生卡片，LLM 只在後台並排比對、不影響卡片。
# 需 SHADOW_ENABLED=true 且所選供應器的金鑰有填才會啟動；否則自動跳過。
# SHADOW_PROVIDER 可切換 gemini 或 openai（各自吃自己的金鑰與 model）。
SHADOW_ENABLED=false
SHADOW_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDED_WORKER_ENABLED=false
AUTO_CREATE_SCHEMA=false
